# GeoSense AI — Environment Variables Template (.env.example)
# Copy this file to .env for local configuration.
# DO NOT COMMIT REAL API KEYS, TOKENS, OR CREDENTIALS TO VERSION CONTROL.

# Backend Configuration (FastAPI)
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173

# NASA FIRMS API Access
# Enter your 32-character NASA FIRMS MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Required for automated NASA FIRMS API downloads & near-real-time ingestion.
# Keep this file local; never commit the real key to Git or expose it to frontend code.
FIRMS_MAP_KEY=

# Frontend Configuration (Vite)
# VITE_API_BASE_URL=http://127.0.0.1:8000
