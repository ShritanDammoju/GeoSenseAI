# GeoSense AI — Frontend Environment Configuration (.env.example)
# Copy this file to .env or .env.local for custom overrides.
#
# For local development, the frontend defaults to http://127.0.0.1:8000 automatically.
# For Vercel / production deployment, set VITE_API_BASE_URL to your deployed backend URL:
VITE_API_BASE_URL=https://geosenseai-iees.onrender.com
